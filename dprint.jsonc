{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "gofumpt": {
    "langVersion": "go1.26",
    "modulePath": "github.com/sargunv/devices-cli",
  },
  "excludes": ["mise.lock"],
  "plugins": [
    "npm:@dprint/oxc@0.47.0",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20",
  ],
}
